# URL del Webhook del Agente IA en n8n
N8N_WEBHOOK_URL=https://cerebro.agencialquimia.com/webhook/v1/agente/consulta

# Configuración de Supabase BaaS (Opcional)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
