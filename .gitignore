# ==============================================================================
# Archivo: .gitignore
# ==============================================================================
# Reglas de exclusión para el control de versiones Git en AgenciAlquimia.
# Previene la inclusión de dependencias, artefactos temporales de build y claves.
# ==============================================================================

# Dependencias de paquetes Node.js
node_modules/
/.pnp
.pnp.js

# Carpeta de compilación y caché de Next.js
.next/
.next-prod/
out/
build/
dist/

# Caché de TypeScript
*.tsbuildinfo
tsconfig.tsbuildinfo

# Variables de entorno locales y secretos
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs y volcados de sistema
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Assets legacy sin uso (conservados en disco, fuera de git)
public/assets/videos/
public/assets/fonts/
